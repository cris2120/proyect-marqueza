    { "name": "Estado", "description": "Estado del servicio" },
    { "name": "Autenticación", "description": "Inicio de sesión y recuperación de contraseña" },
    { "name": "Usuarios", "description": "Gestión de usuarios" },
    { "name": "Clientes", "description": "Gestión de clientes" },
    { "name": "Contactos", "description": "Gestión de contactos de proveedores" },
    { "name": "Cotizaciones", "description": "Gestión de cotizaciones" },
    { "name": "Detalles ETC", "description": "Gestión de detalles de catálogos ETC" },
    { "name": "ETC", "description": "Gestión de catálogos ETC" },
    { "name": "Insumos", "description": "Inventario de insumos" },
    { "name": "Personas", "description": "Gestión de personas" },
    { "name": "Productos-insumos", "description": "Relación entre productos e insumos" },
    { "name": "Productos", "description": "Catálogo de productos" },
    { "name": "Proveedores", "description": "Gestión de proveedores" },
    { "name": "Ventas-productos", "description": "Productos asociados a ventas" },
    { "name": "Ventas", "description": "Operaciones de venta" },
    { "name": "Documentación", "description": "Registros de documentación" },
    { "name": "Detalle cotización", "description": "Productos asociados a cotizaciones" },
    { "name": "Recuperación de contraseña", "description": "Gestión de solicitudes de recuperación" },
    { "name": "Bitácora de auditoría", "description": "Registro de eventos de auditoría" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Estado"],
        "summary": "Verificar API y conexión a la base de datos",
        "operationId": "getHealth",
        "responses": {
          "200": { "description": "Estado del servicio y conexión a base de datos" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Iniciar sesión con usuario o correo",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "correo": { "type": "string", "format": "email" },
                  "usuario": { "type": "string" },
                  "contrasena": { "type": "string" },
                  "password": { "type": "string" }
                },
                "anyOf": [
                  { "required": ["correo", "contrasena"] },
                  { "required": ["correo", "password"] },
                  { "required": ["usuario", "contrasena"] },
                  { "required": ["usuario", "password"] }
                ]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Inicio de sesión exitoso" },
          "400": { "description": "Falta el usuario/correo o la contraseña" },
          "401": { "description": "Credenciales inválidas" },
          "403": { "description": "Cuenta desactivada" }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Solicitar recuperación de contraseña",
        "operationId": "forgotPassword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["correo"],
                "properties": {
                  "correo": { "type": "string", "format": "email" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Correo de recuperación enviado" },
          "400": { "description": "Correo inválido" },
          "502": { "description": "No fue posible enviar el correo" },
          "503": { "description": "El servicio de correo no está configurado" }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Restablecer contraseña con el token recibido por correo",
        "operationId": "resetPassword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token", "nueva_contrasena"],
                "properties": {
                  "token": { "type": "string" },
                  "nueva_contrasena": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Contraseña actualizada" },
          "400": { "description": "Token inválido/expirado o campos faltantes" },
          "404": { "description": "Usuario no encontrado" }
        }
      }
    },
